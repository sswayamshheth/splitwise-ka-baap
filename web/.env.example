# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Supabase (optional — without SUPABASE_SECRET_KEY the app stores data in web/.data/db.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Razorpay — TEST MODE keys only (rzp_test_...). Server-side only; never exposed to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you choose in Razorpay Dashboard → Webhooks (URL: https://<public-host>/api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=

# Optional: Claude for the "Ask the ledger" assistant (offline mode works without it)
ANTHROPIC_API_KEY=

# Local `next start` only: use .data/db.json in production mode. Never set on Vercel.
# ALLOW_LOCAL_FILE_STORE=1

# Blockchain anchoring (Ethereum Sepolia testnet) — see docs/BLOCKCHAIN.md
ANCHOR_PRIVATE_KEY=
ANCHOR_SALT=
ANCHOR_CONTRACT=
ANCHOR_DEPLOY_BLOCK=
# ANCHOR_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
